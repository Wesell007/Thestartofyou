VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Optional consent-gated analytics. Autocapture and session replay remain off.
VITE_POSTHOG_KEY=your-posthog-project-key
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Optional: override the default Amazon product page in production.
VITE_JOURNAL_PURCHASE_URL=https://www.amazon.co.uk/your-journal-listing

# AIC-4 — companion conversation history.
# Client gate for the persistent-history experience. Session continuity does
# not depend on it. Default off.
VITE_COMPANION_HISTORY_ENABLED=false
# Server gate (edge function secret, configured separately): no conversation
# row is written or read unless AI_CONVERSATION_HISTORY_ENABLED=true.
