# Local development is fail-closed. Without a .env the dev server uses a
# non-production placeholder backend (https://placeholder.supabase.co), so it
# can never reach production by accident. Point these at a NON-production
# Supabase project (or a local `supabase start` stack) for real backend work.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Deliberate production opt-in for a local session. The dev server refuses the
# production VITE_SUPABASE_URL unless this is exactly "true", and prints a loud
# warning when it is. Leave it unset or false for normal development.
VITE_ALLOW_PRODUCTION_BACKEND=false

# Optional consent-gated analytics. Autocapture and session replay remain off.
VITE_POSTHOG_KEY=your-posthog-project-key
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Optional: override the default Amazon product page in production.
VITE_JOURNAL_PURCHASE_URL=https://www.amazon.co.uk/your-journal-listing

# AIC-4 — companion conversation history.
# Client gate for the persistent-history experience. Session continuity does
# not depend on it. Default off.
VITE_COMPANION_HISTORY_ENABLED=false
# Server gate (edge function secret, configured separately): no conversation
# row is written or read unless AI_CONVERSATION_HISTORY_ENABLED=true.
