# Backend selection is explicit (docs/strategy/tsoy-environment-strategy.md).
# There is no committed fallback backend. Copy this file to .env (gitignored) and
# fill in the values for the environment you are working against.
#
#   local / staging  : point at the permanent tsoy-staging project (or a local
#                      `supabase start` stack). Values come from the staging
#                      project's API settings; never commit them.
#   production       : no production backend exists yet (tsoy-production is
#                      created at Gate 7). Production builds fail closed.
#
# Without a .env, the dev server uses an inert placeholder backend and cannot
# reach any real project. Historical and retired projects are always refused.
VITE_TSOY_ENVIRONMENT=staging
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Deliberate opt-in for pointing a local session at the registered production
# backend (none exists yet). Leave it unset or false.
VITE_ALLOW_PRODUCTION_BACKEND=false

# Optional consent-gated analytics. Autocapture and session replay remain off.
VITE_POSTHOG_KEY=your-posthog-project-key
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Optional: override the default Amazon product page in production.
VITE_JOURNAL_PURCHASE_URL=https://www.amazon.co.uk/your-journal-listing

# AIC-4 — companion conversation history.
# Client gate for the persistent-history experience. Session continuity does
# not depend on it. Default off.
VITE_COMPANION_HISTORY_ENABLED=false
# Server gate (edge function secret, configured separately): no conversation
# row is written or read unless AI_CONVERSATION_HISTORY_ENABLED=true.
